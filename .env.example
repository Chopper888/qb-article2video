# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会提交）。
# 引擎只从「进程环境变量」读取密钥，不会自动解析 .env；
# 运行前请按 README 里的方法把本文件内容加载进当前终端会话。

# ===== 必填：DeepSeek（口播稿、分组、标注等文本生成）=====
DEEPSEEK_API_KEY=your_deepseek_api_key

# ===== 必填：火山方舟（识图）=====
ARK_API_KEY=your_ark_api_key

# ===== 必填：豆包语音（配音 TTS）=====
MODEL_SPEECH_API_KEY=your_doubao_speech_api_key

# ===== 必填：RunningHub（插画与标题图生成）=====
RUNNINGHUB_API_KEY=your_runninghub_api_key

# ===== 可选：飞书（从飞书文档导入文章时需要）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 可选：配音音色（豆包 TTS 音色编号）=====
# 留空使用公共中文音色 zh_female_shuangkuaisisi_uranus_bigtts（需开通「语音合成大模型」）；
# 填写自己复刻的音色编号（S_ 开头）时自动使用 seed-icl-2.0（需开通「声音复刻」）。
A2V_TTS_SPEAKER=
# 可选：手动覆盖资源编号。留空按音色自动选择：
# S_ 开头=seed-icl-2.0；_uranus_bigtts=seed-tts-2.0；_mars_bigtts=seed-tts-1.0
A2V_TTS_RESOURCE_ID=
