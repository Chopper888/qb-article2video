{
  "name": "wenzhang-chengpian",
  "version": "1.0.1",
  "description": "Article2Video desktop shell with Mock and Real v4.1 development integration",
  "main": "./out/main/index.js",
  "author": "Article2Video APP",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "runtime:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/runtime/verify-runtime-pack.ps1",
    "pack:win": "npm run runtime:verify && npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run runtime:verify && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
