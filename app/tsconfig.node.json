{
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/engine/**/*.ts",
    "src/storage/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "src/test-fixtures/**/*.ts"
  ]
}
